# The project's secrets, one file for the CLI, the dashboard (and the dops-ai
# processes it starts) and the Claude Code plugin. Keep it outside any
# repository, e.g. ~/.config/dops/<project>.env (chmod 600), and point
# `envFile` in dops.config.yml at it. A .env next to dops.config.yml works too.
# Variables already set in the shell always win.

# Values referenced as ${VAR} in dops.config.yml, environments/ and pipelines/
DOPS_BASTION_HOST=
# DOPS_KEY_PASSPHRASE=

# Dashboard token (at least 16 characters; otherwise one is printed on start)
# DOPS_TOKEN=

# Basic auth for test environments, see visual.urlSets.*.httpAuth
# TEST_HTTP_USER=
# TEST_HTTP_PASS=

# Jira and AI review (dops-ai)
# JIRA_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# ANTHROPIC_API_KEY=

# Incoming webhook for failing UI test suites (uiTests.notify)
# DOPS_WEBHOOK_URL=
