# Copy to .env (gitignored). Variables already set in the shell take precedence.

# Values referenced as ${VAR} in dops.config.yml
DOPS_BASTION_HOST=
# DOPS_KEY_PASSPHRASE=

# Dashboard token (otherwise a random one is printed on start)
# DOPS_TOKEN=

# Basic auth for visual checks, see visual.urlSets.*.httpAuth
# STAGING_HTTP_USER=
# STAGING_HTTP_PASS=

# Incoming webhook for failing UI test suites (uiTests.notify)
# DOPS_WEBHOOK_URL=
