# Copy to ~/.config/dops/<project>.env and chmod 600. Never commit it.

# Jira (read-only use): https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# HTTP basic auth in front of the remote test environments
TEST_HTTP_USER=
TEST_HTTP_PASS=

# Back-office account used to create test content on remote test environments
TEST_BO_USER=
TEST_BO_PASS=
# TEST_BO_PASS_FALLBACK=
