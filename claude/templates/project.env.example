# One file per project for every dops tool: the CLI, the dashboard (and the
# dops-ai processes it starts) and the Claude Code skills.
# Copy to ~/.config/dops/<project>.env, chmod 600, and point envFile in
# dops.config.yml and env_file in .claude/dops/project.md at it. Never commit it.

# Hosts and users referenced as ${VAR} in dops.config.yml, environments/ and pipelines/
DOPS_BASTION_HOST=
# DOPS_KEY_PASSPHRASE=

# Dashboard token (at least 16 characters; otherwise one is printed on start)
# DOPS_TOKEN=

# HTTP basic auth in front of the test environments (visual URL sets, UI tests, test content)
TEST_HTTP_USER=
TEST_HTTP_PASS=

# Back-office account used to create test content on test environments
TEST_BO_USER=
TEST_BO_PASS=
# TEST_BO_PASS_FALLBACK=

# Jira, read-only use: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# DOPS_JIRA_JQL=

# AI review (dops-ai)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Webhook for failing UI test suites (uiTests.notify)
# DOPS_WEBHOOK_URL=
